# Demo mode (what the public GitHub Pages site uses): fictional data, saved in the browser, no backend.
# VITE_DEMO=true

# Live mode: a real Supabase project. Both values are safe to be public (every Supabase web app ships
# them to the browser); access is enforced by row-level security. Never put the service-role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=
